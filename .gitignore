# Bazel output directories and symlinks
/bazel-*

# CMake out-of-tree build directories
/build/
/cmake-build*/

# Compiled object and archive artifacts
*.o
*.a

# ROM socket contents stay on this machine. The directories themselves
# remain, via .gitkeep, so the emulator still has a place to look.
/bbc_b_rom_sockets/*
!/bbc_b_rom_sockets/.gitkeep
/bbc_master_rom_sockets/*
!/bbc_master_rom_sockets/.gitkeep
